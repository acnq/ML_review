   "source": [
    "## Evaluation Metrics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# accuracy: # correct Pred / # examples\n",
    "sum(y == y_hat) / y.size\n",
    "\n",
    "# Precission: # True pos / #(True pos + False pos)\n",
    "sum((y_hat == 1) & (y == 1)) / sum(y_hat == 1)\n",
    "\n",
    "# recall: # true pos / # pos example\n",
    "sum((y_hat == 1) & (y == 1)) / sum(y == 1)"
   ]
  },
